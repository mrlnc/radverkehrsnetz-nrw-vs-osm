FROM ubuntu:24.04

RUN apt-get update && apt-get install -y \
    curl \
    gdal-bin \
    osmium-tool \
    tippecanoe \
    python3 \
    python3-pip \
    && pip3 install --break-system-packages --no-cache-dir geopandas shapely pyproj \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY download-osm.sh download-radwege-nrw.sh diff.py ./
RUN chmod +x *.sh

RUN mkdir -p data tiles diff

CMD ["/bin/bash"]
