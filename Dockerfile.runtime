FROM node:20-alpine AS frontend-builder

WORKDIR /app

COPY package.json ./
RUN npm install --omit=dev

COPY public ./public
COPY src ./src

RUN mkdir -p public/thirdparty \
    && cp node_modules/maplibre-gl/dist/maplibre-gl.css public/thirdparty/maplibre-gl.css \
    && cp node_modules/maplibre-gl/dist/maplibre-gl.js public/thirdparty/maplibre-gl.js \
    && cp node_modules/proj4/dist/proj4.js public/thirdparty/proj4.js \
    && cp node_modules/@tailwindcss/browser/dist/index.global.js public/thirdparty/tailwindcss-browser.js

FROM nginx:alpine

COPY --from=frontend-builder /app/public /usr/share/nginx/html
COPY reverse-proxy.conf /etc/nginx/nginx.conf
